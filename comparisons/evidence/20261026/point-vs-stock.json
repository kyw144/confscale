    },
    "e2e_run_p95_ms": {
      "definition": "Run-level 95th percentile of per-tick p95 latencies. Tick latencies use successful requests; a tick with no successful requests records zero. This is not the p95 of pooled requests.",
      "unit": "ms"
    },
    "overhead_replica_seconds_per_hour": {
      "definition": "Overhead replica-seconds above one minimum replica, divided by configured workload duration in hours.",
      "unit": "replica-seconds/hour"
    },
    "tick_slo_violation_fraction": {
      "definition": "Fraction of workload ticks whose successful-request p95 exceeds 200 ms; zero-success ticks have p95 zero and therefore do not count as violations.",
      "threshold_ms": 200,
      "unit": "fraction"
    }
  },
